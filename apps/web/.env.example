# ============================================
# ĐỐNG LỬA V2 — Frontend Environment Variables
# ============================================
# Copy file này thành .env.local để dev local
# Trên Vercel: set các biến này trong Settings > Environment Variables

# URL của backend Fly.io (không có / ở cuối)
# Để trống khi dev local (Vite sẽ proxy tới localhost:3001)
VITE_API_URL=

# Ví dụ production:
# VITE_API_URL=https://dongluav2.fly.dev
