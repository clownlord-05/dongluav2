{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@dongluav2/shared-types": [
        "../../packages/shared-types/src/index",
        "../../packages/shared-types/dist/index"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
